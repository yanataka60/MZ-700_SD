00055E F55E C9              10          RET
                                        
                                ;**** 1BYTE送信 ****
                                ;Aレジスタの内容をPORTA下位4BITに4BITずつ送信
       F55F                     SNDBYTE:
00055F F55F F5              11          PUSH    AF
000560 F560 1F               4          RRA
000561 F561 1F               4          RRA
000562 F562 1F               4          RRA
000563 F563 1F               4          RRA
000564 F564 E60F             7          AND     0FH
000566 F566 CD70F5          17          CALL    SND4BIT
000569 F569 F1              10          POP     AF
00056A F56A E60F             7          AND     0FH
00056C F56C CD70F5          17          CALL    SND4BIT
00056F F56F C9              10          RET
                                
                                ;**** 4BIT送信 ****
                                ;Aレジスタ下位4ビットを送信する
       F570                     SND4BIT:
000570 F570 D3D8            11          OUT     (0D8H),A
000572 F572 3E05             7          LD      A,05H
000574 F574 D3DB            11          OUT     (0DBH),A    ;PORTC BIT2 <- 1
000576 F576 CD81F5          17          CALL    F1CHK      ;PORTC BIT7が1になるまでLOOP
000579 F579 3E04             7          LD      A,04H
00057B F57B D3DB            11          OUT     (0DBH),A    ;PORTC BIT2 <- 0
00057D F57D CD88F5          17          CALL    F2CHK
000580 F580 C9              10          RET
                                        
                                ;**** BUSYをCHECK(1) ****
                                ; 82H BIT7が1になるまでLOP
000581 F581 DBDA            11  F1CHK:  IN      A,(0DAH)
000583 F583 E680             7          AND     80H        ;PORTC BIT7 = 1?
000585 F585 28FA            12          JR      Z,F1CHK
000587 F587 C9              10          RET
                                
                                ;**** BUSYをCHECK(0) ****
                                ; 82H BIT7が0になるまでLOOP
000588 F588 DBDA            11  F2CHK:  IN      A,(0DAH)
00058A F58A E680             7          AND     80H        ;PORTC BIT7 = 0?
00058C F58C 20FA            12          JR      NZ,F2CHK
00058E F58E C9              10          RET
                                
