0000CF F0CF 23               6          INC     HL
0000D0 F0D0 CD4CF5          17          CALL    RCVBYTE
0000D3 F0D3 77               7          LD      (HL),A
0000D4 F0D4 210211          10          LD      HL,FSIZE   ;FSIZE取得
0000D7 F0D7 CD4CF5          17          CALL    RCVBYTE
0000DA F0DA 77               7          LD      (HL),A
0000DB F0DB 23               6          INC     HL
0000DC F0DC CD4CF5          17          CALL    RCVBYTE
