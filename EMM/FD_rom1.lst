                                ;*** AILZ80ASM *** Z-80 Assembler, version 1.0.28.0, LST:Full:4
                                ;2021.12.12 MZ-700でFDP、FDMが文字化けする現象に対処
                                ;2022. 1.23 04D8H MONITOR リード インフォメーション代替処理のバグを修正
                                ;2022. 1.24 ファイルネームの後ろの20h詰めを0dhに修正するための処理をArduino側からMZ-80K側に修正
                                ;2022. 1.25 0475H MONITOR ライト データ代替処理、04F8H MONITOR リード データ代替処理での8255初期化を廃止
                                ;2022. 1.26 FDコマンドでロード可能なファイル種類コードは0x01のみとしていた制限を撤廃
                                ;2022. 1.29 CMT代替処理RETURN時の割込み許可(EI)を削除
                                ;2022. 1.31 FDコマンド実行後アプリ動作が固まってしまう機械、アプリへの対処
                                ;2022. 1.31 FDLコマンド仕様変更 FDL xの場合、ファイル名先頭一文字を比較して一致したものだけを出力
                                ;           Bキーで前の20件を表示
                                ;2022. 2. 8 FDLコマンド仕様変更 FDL xの場合、ファイル名先頭1文字～32文字までに拡張
                                ;2022. 2.10 04D8H MONITOR リード インフォメーション代替処理の中からFDLコマンドを使えるように修正
                                ;           FDLコマンド処理をサブルーチン化
                                ;2022. 2.11 04D8H MONITOR リード インフォメーション代替処理の中から呼ぶFDLコマンドがMZ-700 MONITOR 1Z-009A、1Z-009B環境下では使えないバグを修正しました。
                                ;
       0003                     GETL        EQU     0003H
       0006                     LETLN       EQU     0006H
       0009                     NEWLIN      EQU     0009H
       000C                     PRNTS       EQU     000CH
       0015                     MSGPR       EQU     0015H
       0018                     PLIST       EQU     0018H
       001B                     GETKEY      EQU     001BH
       0033                     TIMST       EQU     0033H
       03BA                     PRTWRD      EQU     03BAH
       03C3                     PRTBYT      EQU     03C3H
       0410                     HLHEX       EQU     0410H
       041F                     TWOHEX      EQU     041FH
       0BB9                     ADCN        EQU     0BB9H
       0DB5                     DISPCH      EQU     0DB5H
       0DDC                     DPCT        EQU     0DDCH
       10F0                     IBUFE       EQU     10F0H
       10F1                     FNAME       EQU     10F1H
       1102                     EADRS       EQU     1102H
       1102                     FSIZE       EQU     1102H
       1104                     SADRS       EQU     1104H
       1106                     EXEAD       EQU     1106H
       1171                     DSPX        EQU     1171H
       11A3                     LBUF        EQU     11A3H
       11AE                     MBUF        EQU     11AEH
       0082                     MONITOR_80K EQU     0082H
       00AD                     MONITOR_700 EQU     00ADH
       CF00                     EMMADRS     EQU     0CF00H
                                
                                ;0D8H PORTA 送信データ(下位4ビット)
                                ;0D9H PORTB 受信データ(8ビット)
                                ;
                                ;0DAH PORTC Bit
                                ;7 IN  CHK
                                ;6 IN
                                ;5 IN
                                ;4 IN 
                                ;3 OUT
                                ;2 OUT FLG
                                ;1 OUT
                                ;0 OUT
                                ;
                                ;0DBH コントロールレジスタ
                                
                                
000000 F000                            ORG      0F000H
                                
000000 F000 00               4          NOP                   ;ROM識別コード
000001 F001 C313F0          10          JP      START
                                ;******************** MONITOR CMTルーチン代替 *************************************
000004 F004 C395F7          10  ENT1:   JP      MSHED
000007 F007 C3E3F7          10  ENT2:   JP      MSDAT
00000A F00A C317F8          10  ENT3:   JP      MLHED
00000D F00D C304F9          10  ENT4:   JP      MLDAT
000010 F010 C337F9          10  ENT5:   JP      MVRFY
                                        
000013 F013 CD82F0          17  START:  CALL    INIT
000016 F016 11A311          10          LD      DE,LBUF     ;MZ-80K、MZ-700とも起動コマンドは'*FD'に統一
000019 F019 1A               7          LD      A,(DE)
00001A F01A FE2A             7          CP      '*'
00001C F01C C29CF1          10          JP      NZ,MON
00001F F01F 13               6          INC     DE
000020 F020 1A               7          LD      A,(DE)
000021 F021 FE46             7          CP      'F'
000023 F023 C29CF1          10          JP      NZ,MON
000026 F026 13               6          INC     DE
000027 F027 1A               7          LD      A,(DE)
000028 F028 FE44             7          CP      'D'
00002A F02A C29CF1          10          JP      NZ,MON
                                        
00002D F02D 13               6          INC     DE          ;FDの次の文字へ移動
00002E F02E 1A               7  STT2:   LD      A,(DE)
00002F F02F FE20             7          CP      20H         ;FDの後に1文字空白があれば以降をファイルネームとしてロード(ファイルネームは32文字まで)
000031 F031 285A            12          JR      Z,SDLOAD
000033 F033 FE2F             7          CP      '/'         ;FDの後が'/'なら以降をファイルネームとしてロード、実行はしない(ファイルネームは32文字まで)
000035 F035 2856            12          JR      Z,SDLOAD
000037 F037 FE0D             7          CP      0DH         ;FDだけで改行の場合にはDEFNAMEの文字列をファイルネームとしてロード
000039 F039 200D            12          JR      NZ,STETC    ;該当なしなら他コマンドをチェック
00003B F03B D5              11  STT3:   PUSH    DE          ;設定ファイル名(0000.mzt)を転送
00003C F03C 218BF7          10          LD      HL,DEFNAME
00003F F03F 13               6          INC     DE
000040 F040 010500          10          LD      BC,NEND-DEFNAME
000043 F043 EDB0                        LDIR
000045 F045 D1              10          POP     DE
000046 F046 1845            12          JR      SDLOAD      ;LOAD処理へ
       F048                     STETC:
000048 F048 FE53             7          CP      'S'         ;FDS:SAVE処理へ
00004A F04A CAFFF0          10          JP      Z,STSV
00004D F04D FE41             7          CP      'A'         ;FDA:自動起動ファイル設定処理へ
00004F F04F CA12F2          10          JP      Z,STAS
000052 F052 FE4C             7          CP      'L'         ;FDL:ファイル一覧表示
000054 F054 CA1DF2          10          JP      Z,STLT
000057 F057 FE44             7          CP      'D'         ;FDD:DELETE
000059 F059 CAB8F2          10          JP      Z,STDE
00005C F05C FE52             7          CP      'R'         ;FDR:RENAME
00005E F05E CAF5F2          10          JP      Z,STRN
000061 F061 FE50             7          CP      'P'         ;FDP:DUMP
000063 F063 CA22F3          10          JP      Z,STPR
000066 F066 FE43             7          CP      'C'         ;FDC:COPY
000068 F068 CAC7F3          10          JP      Z,STCP
00006B F06B FE4D             7          CP      'M'         ;FDM:MEMORY DUMP
00006D F06D CAF4F3          10          JP      Z,STMD
000070 F070 FE57             7          CP      'W'         ;FDW:MEMORY WRITE
000072 F072 CA79F4          10          JP      Z,STMW
000075 F075 FE5A             7          CP      'Z'         ;FDZ:MZ-700 PATCH START
000077 F077 CAC6F4          10          JP      Z,STMZ
00007A F07A FE55             7          CP      'U'         ;FDU:MZ-700 裏RAM START
00007C F07C CA35F5          10          JP      Z,STURA
00007F F07F C36BF9          10          JP      EMMCHK
                                
                                ;**** 8255初期化 ****
                                ;PORTC下位BITをOUTPUT、上位BITをINPUT、PORTBをINPUT、PORTAをOUTPUT
000082 F082 3E8A             7  INIT:   LD      A,8AH
000084 F084 D3DB            11          OUT     (0DBH),A
