0000BC F0BC CD1500          17          CALL    MSGPR
0000BF F0BF 11F110          10          LD      DE,FNAME
0000C2 F0C2 CD1500          17          CALL    MSGPR
0000C5 F0C5 CD0600          17          CALL    LETLN
0000C8 F0C8 210411          10          LD      HL,SADRS  ;SADRS取得
0000CB F0CB CD4CF5          17          CALL    RCVBYTE
